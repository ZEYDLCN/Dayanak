# Kopyalayin: cp .env.example .env  (gercek anahtari .env icine yazin, .env git'e girmez)

# LLM saglayici: "anthropic" veya "none" (none = LLM'siz, alintilayan/extractive mod)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# Dokuman klasoru
DOCS_DIR=data/docs

# Arama / "cevapsiz" esikleri
TOP_K=4
MIN_SCORE=2.0
MIN_COVERAGE=0.5
