# Kopyalayin: cp .env.example .env  (gercek anahtari .env icine yazin, .env git'e girmez)

# LLM saglayici: "anthropic", "nvidia" veya "none" (none = alintilayan mod)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_TIMEOUT_SECONDS=15

# Dokuman klasoru
DOCS_DIR=data/docs

# Arama / "cevapsiz" esikleri
TOP_K=4
MIN_SCORE=5.0
MIN_COVERAGE=0.27
