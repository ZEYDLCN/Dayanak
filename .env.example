# Kopyalayin: cp .env.example .env  (gercek anahtari .env icine yazin, .env git'e girmez)

# LLM saglayici: "nvidia" (hizli), "gemini" (daha az gereksiz ret, ~3x yavas), "anthropic" veya "none" (none = alintilayan mod, anahtar gerekmez)
LLM_PROVIDER=nvidia

# --- NVIDIA (build.nvidia.com anahtari). Olculen hizli model: openai/gpt-oss-20b (tipik ~1.5 sn)
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_TIMEOUT_SECONDS=15
NVIDIA_TEMPERATURE=0
NVIDIA_REASONING_EFFORT=low

# --- Google Gemini (LLM_PROVIDER=gemini ise). Anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=20

# --- Anthropic (LLM_PROVIDER=anthropic ise)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Dokuman klasoru
DOCS_DIR=data/docs

# Arama
TOP_K=4
# LLM'e verilen en iyi bolum sayisi (2 olculdu; 4 daha iyi cikmadi, sadece yavasladi)
LLM_CONTEXT_PASSAGES=2
# "Cevapsiz" on-eleme esikleri (LLM'siz modda skor VE kapsama, LLM varken VEYA)
MIN_SCORE=5.0
MIN_COVERAGE=0.27

# Halusinasyon korumalari
# Model, cevabi destekleyen cumleyi bolumden aynen kopyalamali; kod dogrular (onerilen: true)
REQUIRE_EVIDENCE=true
# Ikinci LLM gecisi: olculdu, uydurmayi azaltmadi, yavaslatti ve gecerli yanitlari reddetti (varsayilan: false)
VERIFY_ANSWERS=false

# --- Istege bagli hibrit (vektor) arama: VARSAYILAN KAPALI. Olculdu, BM25'e ustunluk saglamadi ve uydurma riskini artirdi (README > Degerlendirme > 5).
# Denemek icin: pip install -r requirements-hybrid.txt
# RETRIEVER=hybrid
# EMBEDDING_MODEL=minishlab/potion-multilingual-128M
# MIN_SEMANTIC=0
